# Salin file ini menjadi .env.local dan isi dengan nilai yang sesuai
# Semua variabel ini WAJIB diisi agar aplikasi berjalan dengan benar

# ── Supabase (ambil dari: Supabase Dashboard > Project Settings > API) ──────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx
# Service role key — JANGAN expose ke client, hanya untuk server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx

# ── Fonnte (WhatsApp gateway — ambil dari: https://fonnte.com/profile) ───────
FONNTE_API_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Cron secret (buat sendiri, string acak — isi juga di Vercel dashboard) ───
# Dipakai untuk mengamankan endpoint /api/cron/* agar tidak bisa dipanggil sembarangan
CRON_SECRET=ganti-dengan-string-acak-yang-panjang
